class Solution:
    def myPowfind(self, x: float, n: int) -> float:
        if n==0:
            return 1
        if n==1:
            return x
        a = self.myPowfind(x,n//2)
        if n%2==1:
            return a*a*x
        else:
            return a*a

    def myPow(self, x: float, n: int) -> float:
        if n > 0:
            return self.myPowfind(x,n)
        else:
            n *= -1
            return 1/self.myPowfind(x,n)
        
