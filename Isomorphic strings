class Solution:
    def isIsomorphic(self, s: str, t: str) -> bool:
        mappings={}
        if len(s)!=len(t):
            return False
        for i in range(len(s)):
            if s[i] not in mappings:
                if t[i] in mappings.values():
                    return False
            if s[i]  in mappings:
                if mappings[s[i]]!=t[i]:
                    return False
            mappings[s[i]]=t[i]
        return True
